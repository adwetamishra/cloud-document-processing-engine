
# Application
APP_NAME=Cloud Document Processing Engine

# PostgreSQL
DATABASE_URL=postgresql+psycopg2://postgres:password@localhost:5432/document_engine

# Redis and Celery
REDIS_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# Apache Tika
TIKA_SERVER_URL=http://localhost:9998

# AWS S3 / Local SeaweedFS
S3_ENDPOINT_URL=http://127.0.0.1:8333
AWS_ACCESS_KEY_ID=localadmin
AWS_SECRET_ACCESS_KEY=localpassword
AWS_DEFAULT_REGION=us-east-1
S3_BUCKET_NAME=document-bucket

# Azure Blob / Local Azurite
AZURE_STORAGE_CONNECTION_STRING=UseDevelopmentStorage=true
AZURE_CONTAINER_NAME=document-container

# Document limits
MAX_FILE_SIZE_MB=50
